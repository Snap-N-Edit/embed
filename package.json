{
  "name": "@snapnedit/embed",
  "version": "0.4.0",
  "description": "Embed the snapnedit AI photo editor in any site: script tag, mount(), or React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snap-N-Edit/embed.git"
  },
  "homepage": "https://snapnedit.com/docs/embed",
  "bugs": {
    "url": "https://github.com/Snap-N-Edit/embed/issues"
  },
  "keywords": [
    "snapnedit",
    "image-editor",
    "photo-editor",
    "embed",
    "iframe",
    "react",
    "ai"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "protocol.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./protocol.json": "./protocol.json"
  },
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@snapnedit/shared": "*",
    "@snapnedit/editor-core": "*",
    "@types/react": "^19.2.17",
    "react": "^19.2.7"
  }
}
